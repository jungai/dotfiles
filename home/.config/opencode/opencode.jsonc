{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "lsp": {},
  "agent": {
    "build": {
      "model": "openai/gpt-5.5",
    },
    "plan": {
      "model": "openai/gpt-5.5",
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "primary", "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.", "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    }
  },
  "references": {
    "effect": {
      "repository": "https://github.com/Effect-TS/effect-smol",
      "description": "use this whenever there's any question about Effect or you need to know how to do something in Effect"
    }
  },
  "provider": {
    "arv": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ARV Provider",
      "options": {
        "baseURL": "https://core-ai-api.horrus.io/v1",
        "apiKey": "sk-FNfXmJWIGdpVNXNCsaw1uQ"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "modalities": {
            "input": ["text", "image", "pdf"]
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
           "input": ["text", "image", "pdf"]
        }
      }
    }
  },
  "plugin": ["@plannotator/opencode@latest"]
}