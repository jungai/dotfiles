# Pi: keep personal/runtime state and secrets out of dotfiles
home/.pi/agent/cache/**
home/.pi/agent/sessions/**
home/.pi/agent/git/**
home/.pi/agent/npm/
home/.pi/agent/run-history.jsonl
home/.pi/agent/trust.json
home/.pi/agent/auth.json
home/.pi/agent/mcp.json
home/.pi/agent/mcp-cache.json
home/.pi/agent/mcp-cache/**
home/.pi/context-mode/**
home/.pi/agent/models-store.json

# Allow portable Pi preferences only
!home/.pi/agent/keybindings.json
!home/.pi/agent/settings.json
!home/.pi/agent/themes/
!home/.pi/agent/themes/*.json

# OMP runtime state
home/.omp/**

# Allow portable OMP preferences only
!home/.omp/agent/
!home/.omp/agent/config.yml
!home/.omp/agent/keybindings.yml

home/.plannotator/**
!home/.plannotator/drafts/

# Local package installs/caches under synced config dirs
home/.config/**/node_modules/**
home/.config/**/.cache/**
home/.config/**/cache/**

# herdr runtime/state
home/.config/herdr/*.log
home/.config/herdr/session-history.json
home/.config/herdr/session.json
home/.config/herdr/sessions/
home/.config/herdr/release-notes.json
home/.config/herdr/plugins.json
home/.config/herdr/plugins/